+    expect(runtime.sessions.retainInfo(third).getSnapshot().retainedBy.conversationSplit).toBeUndefined()
+    expect(runtime.sessions.retainInfo(fourth).getSnapshot().retainedBy.conversationSplit).toBe(1)
