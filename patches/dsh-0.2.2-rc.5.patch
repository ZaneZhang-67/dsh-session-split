+import { describe, expect, it } from 'vitest'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import {
+  closeSplit, createSplitState, focusSplit, MAX_SPLIT_RATIO, MIN_SPLIT_RATIO,
+  openSplit, removeSplitSession, resizeSplit, selectSession,
+} from '../src/client/split-state.ts'
+
+const a = 'a' as SessionId
+const b = 'b' as SessionId
+const c = 'c' as SessionId
+
+function split() {
+  return openSplit(selectSession(createSplitState(), a), b, 'right')
+}
+
+describe('Conversation split state', () => {
+  it('starts empty and leaves focus, close, resize and removal unchanged', () => {
+    const empty = createSplitState()
+    expect(empty).toEqual({ kind: 'empty' })
+    expect(focusSplit(empty, 'left')).toBe(empty)
+    expect(closeSplit(empty, 'right')).toBe(empty)
+    expect(resizeSplit(empty, 0.7)).toBe(empty)
+    expect(removeSplitSession(empty, a)).toBe(empty)
+    expect(openSplit(empty, a, 'left')).toEqual({ kind: 'single', sessionId: a })
+    expect(openSplit(empty, a, 'right')).toEqual({ kind: 'single', sessionId: a })
+  })
+
+  it('opens and switches a single Session without creating a split', () => {
+    const single = selectSession(createSplitState(), a)
+    expect(single).toEqual({ kind: 'single', sessionId: a })
+    expect(selectSession(single, a)).toBe(single)
+    expect(selectSession(single, b)).toEqual({ kind: 'single', sessionId: b })
+    expect(openSplit(single, a, 'left')).toBe(single)
+    expect(openSplit(single, a, 'right')).toBe(single)
+    expect(focusSplit(single, 'right')).toBe(single)
+    expect(closeSplit(single, 'left')).toBe(single)
+    expect(resizeSplit(single, 0.3)).toBe(single)
+  })
+
+  it('places the dragged Session on either side and preserves the original', () => {
+    const single = selectSession(createSplitState(), a)
+    expect(openSplit(single, b, 'left')).toEqual({
+      kind: 'split', left: b, right: a, focused: 'left', ratio: 0.5,
+    })
+    expect(openSplit(single, b, 'right')).toEqual({
+      kind: 'split', left: a, right: b, focused: 'right', ratio: 0.5,
+    })
+    expect(single).toEqual({ kind: 'single', sessionId: a })
+  })
+
+  it('focuses an existing Session on drop and rejects a third Session', () => {
+    const initial = split()
+    expect(openSplit(initial, c, 'left')).toBe(initial)
+    expect(openSplit(initial, c, 'right')).toBe(initial)
+    expect(openSplit(initial, b, 'left')).toBe(initial)
+    const left = openSplit(initial, a, 'right')
+    expect(left).toEqual({ kind: 'split', left: a, right: b, focused: 'left', ratio: 0.5 })
+    expect(openSplit(left, a, 'right')).toBe(left)
+    expect(openSplit(left, b, 'left')).toEqual(initial)
+  })
+
+  it('switches only the focused side and focuses Sessions already shown', () => {
+    const initial = split()
+    expect(selectSession(initial, b)).toBe(initial)
+    const left = selectSession(initial, a)
+    expect(left).toEqual({ kind: 'split', left: a, right: b, focused: 'left', ratio: 0.5 })
+    expect(selectSession(left, a)).toBe(left)
+    expect(selectSession(left, b)).toEqual(initial)
+    expect(selectSession(left, c)).toEqual({ kind: 'split', left: c, right: b, focused: 'left', ratio: 0.5 })
+    expect(selectSession(initial, c)).toEqual({ kind: 'split', left: a, right: c, focused: 'right', ratio: 0.5 })
+  })
+
+  it('focuses sides without changing the order and closes either side', () => {
+    const initial = split()
+    expect(focusSplit(initial, 'right')).toBe(initial)
+    const left = focusSplit(initial, 'left')
+    expect(left).toEqual({ kind: 'split', left: a, right: b, focused: 'left', ratio: 0.5 })
+    expect(closeSplit(left, 'left')).toEqual({ kind: 'single', sessionId: b })
+    expect(closeSplit(left, 'right')).toEqual({ kind: 'single', sessionId: a })
+    expect(closeSplit(initial, 'left')).toEqual({ kind: 'single', sessionId: b })
+    expect(closeSplit(initial, 'right')).toEqual({ kind: 'single', sessionId: a })
+  })
+
+  it('removes only a visible Session and never leaves focus on a missing side', () => {
+    const empty = createSplitState()
+    const single = selectSession(empty, a)
+    const both = split()
+    expect(removeSplitSession(single, b)).toBe(single)
+    expect(removeSplitSession(single, a)).toEqual(empty)
+    expect(removeSplitSession(both, c)).toBe(both)
+    expect(removeSplitSession(both, a)).toEqual({ kind: 'single', sessionId: b })
+    expect(removeSplitSession(both, b)).toEqual({ kind: 'single', sessionId: a })
+  })
+
+  it('clamps width at both limits and ignores non-finite requests', () => {
+    const initial = split()
+    expect(resizeSplit(initial, NaN)).toBe(initial)
+    expect(resizeSplit(initial, Infinity)).toBe(initial)
+    expect(resizeSplit(initial, -Infinity)).toBe(initial)
+    expect(resizeSplit(initial, 0.5)).toBe(initial)
+    expect(resizeSplit(initial, 0)).toMatchObject({ ratio: MIN_SPLIT_RATIO })
+    expect(resizeSplit(initial, MIN_SPLIT_RATIO)).toMatchObject({ ratio: MIN_SPLIT_RATIO })
+    expect(resizeSplit(initial, 1)).toMatchObject({ ratio: MAX_SPLIT_RATIO })
+    expect(resizeSplit(initial, MAX_SPLIT_RATIO)).toMatchObject({ ratio: MAX_SPLIT_RATIO })
+    expect(resizeSplit(initial, 0.6)).toEqual({ kind: 'split', left: a, right: b, focused: 'right', ratio: 0.6 })
+  })
+
+  it('preserves Session ordering through focus, resize, replacement, close and reopen', () => {
+    let state = selectSession(createSplitState(), a)
+    state = openSplit(state, b, 'left')
+    state = focusSplit(state, 'right')
+    state = resizeSplit(state, 0.7)
+    state = selectSession(state, c)
+    expect(state).toEqual({ kind: 'split', left: b, right: c, focused: 'right', ratio: 0.7 })
+    state = closeSplit(state, 'left')
+    expect(state).toEqual({ kind: 'single', sessionId: c })
+    state = openSplit(state, a, 'right')
+    expect(state).toEqual({ kind: 'split', left: c, right: a, focused: 'right', ratio: 0.5 })
+  })
+})
