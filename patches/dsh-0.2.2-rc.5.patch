+// @vitest-environment jsdom
+import './control-row-dom.ts'
+import { act, fireEvent, waitFor, within } from '@testing-library/react'
+import { useState } from 'react'
+import { describe, expect, it, onTestFinished, vi } from 'vitest'
+import type { ISession, SessionReference } from '@deepseek-ai/dsh-api-session-controller/client'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { SlotTestRuntime, stubConfigForm } from '@deepseek-ai/dsh-client-test-runtime'
+import { apply as applyMenus, inject as injectMenus } from '@deepseek-ai/dsh-client-ui-context-menu/client'
+import { apply, inject } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { InputHub } from '../src/client/input/hub.ts'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface SlotMap {
+    'two-session-poc.scope': { kind: 'single'; scope: 'session' }
+  }
+}
+
+class ResizeObserverStub {
+  observe(): void {}
+  unobserve(): void {}
+  disconnect(): void {}
+}
+
+describe('independent Conversation content occurrences', () => {
+  it.each(['embedded', 'main'] as const)('routes each %s composer to its Session while another occurrence is removed', async (mode) => {
+    vi.stubGlobal('ResizeObserver', ResizeObserverStub)
+    const range = Object.getOwnPropertyDescriptor(Range.prototype, 'getBoundingClientRect')
+    Object.defineProperty(Range.prototype, 'getBoundingClientRect', {
+      configurable: true,
+      value: () => ({ top: 0, bottom: 0, left: 0, right: 0, width: 0, height: 0, x: 0, y: 0, toJSON: () => ({}) }),
+    })
+    onTestFinished(() => {
+      vi.unstubAllGlobals()
+      if (range === undefined) Reflect.deleteProperty(Range.prototype, 'getBoundingClientRect')
+      else Object.defineProperty(Range.prototype, 'getBoundingClientRect', range)
+    })
+
+    const runtime = await SlotTestRuntime.create()
+    let firstReference: SessionReference | undefined
+    let secondReference: SessionReference | undefined
+    onTestFinished(async () => {
+      await runtime.dispose()
+      firstReference?.release()
+      secondReference?.release()
+    })
+    runtime.ctx.provide('uiWorkspace', { openWorkspace: vi.fn(), openSession: vi.fn() } as never)
+    runtime.ctx.provide('configForms', {
+      developerTools: { enabled: createSnapshotStore(true) },
+      get: () => stubConfigForm().scope,
+    } as never)
+    const locale = new LocaleRuntime(runtime.ctx)
+    runtime.ctx.provide('locale', locale)
+    runtime.slots.installLocale(locale)
+    runtime.ctx.provide('shortcuts', { catalog: createSnapshotStore([]) })
+    await runtime.mount({ inject: [...injectMenus], apply: applyMenus })
+
+    const first = 'split-poc-first' as SessionId
+    const second = 'split-poc-second' as SessionId
+    const pending = Promise.withResolvers<Awaited<ReturnType<ISession['prompt']>>>()
+    onTestFinished(() => { pending.resolve({ ok: true, value: { accepted: true } }) })
+    const promptFirst = vi.fn<ISession['prompt']>(() => pending.promise)
+    const promptSecond = vi.fn<ISession['prompt']>(async () => ({ ok: true, value: { accepted: true } }))
+    await runtime.sessions.add({ id: first, summary: { cwd: '/first', title: 'First Session', displayTitle: 'First Session' }, session: { prompt: promptFirst } })
+    await runtime.sessions.add({ id: second, summary: { cwd: '/second', title: 'Second Session', displayTitle: 'Second Session' }, session: { prompt: promptSecond } })
+    firstReference = runtime.sessions.retain(first)
+    secondReference = runtime.sessions.retain(second)
+    const firstViewReference = firstReference
+    const secondViewReference = secondReference
+    await Promise.all([firstViewReference.ready, secondViewReference.ready])
+
+    await runtime.root.declare({
+      'main': { kind: 'keyed', scope: 'root' },
+      'two-session-poc.scope': { kind: 'single', scope: 'session' },
+    }, ({ renderFactorySlot, renderSlot, SessionProvider }) => {
+      const [showFirst, setShowFirst] = useState(true)
+      const pane = (reference: SessionReference) => (
+        <SessionProvider session={reference}>
+          {mode === 'main'
+            ? renderSlot('main', {}, { entryKey: 'conversation' })
+            : renderFactorySlot('conversation.content', { variant: 'embedded', phase: 'active', hero: false })}
+        </SessionProvider>
+      )
+      return <>
+        <button onClick={() => { setShowFirst(false) }}>Close first</button>
+        {showFirst && <section data-testid="first">{pane(firstViewReference)}</section>}
+        <section data-testid="second">{pane(secondViewReference)}</section>
+      </>
+    })
+    await runtime.mount({ inject: [...inject], apply })
+    const view = runtime.renderRoot()
+    const input = runtime.ctx.conversation.input as InputHub
+    const firstShell = input.shell(first)
+    const secondShell = input.shell(second)
+    expect(firstShell).not.toBe(secondShell)
+    const firstPane = view.getByTestId('first')
+    const secondPane = view.getByTestId('second')
+    if (mode === 'main') {
+      expect(within(firstPane).getByText('First Session')).toBeTruthy()
+      expect(within(secondPane).getByText('Second Session')).toBeTruthy()
+      expect(within(firstPane).queryByText('Second Session')).toBeNull()
+      expect(within(secondPane).queryByText('First Session')).toBeNull()
+    }
+    expect(firstPane.querySelector('[data-conversation-content]')?.getAttribute('data-conversation-session')).toBe(first)
+    expect(secondPane.querySelector('[data-conversation-content]')?.getAttribute('data-conversation-session')).toBe(second)
+    const firstEditor = firstPane.querySelector<HTMLDivElement>('[data-composer-input]')!
+    const secondEditor = secondPane.querySelector<HTMLDivElement>('[data-composer-input]')!
+    expect(firstEditor.getAttribute('contenteditable')).toBe('true')
+    expect(secondEditor.getAttribute('contenteditable')).toBe('true')
+
+    act(() => { firstShell.setDraft('message for first'); secondShell.setDraft('message for second') })
+    await waitFor(() => {
+      expect(firstEditor.textContent).toContain('message for first')
+      expect(secondEditor.textContent).toContain('message for second')
+    })
+    fireEvent.keyDown(firstEditor, { key: 'Enter', code: 'Enter' })
+    await waitFor(() => { expect(promptFirst).toHaveBeenCalledOnce() })
+    expect(promptSecond).not.toHaveBeenCalled()
+    expect(secondShell.snapshot.draft).toBe('message for second')
+    fireEvent.keyDown(secondEditor, { key: 'Enter', code: 'Enter' })
+    await waitFor(() => { expect(promptSecond).toHaveBeenCalledOnce() })
+    expect(firstShell.snapshot.phase).toBe('sending')
+    expect(promptFirst.mock.calls[0]?.[0]).toEqual(expect.arrayContaining([expect.objectContaining({ text: 'message for first' })]))
+    expect(promptSecond.mock.calls[0]?.[0]).toEqual(expect.arrayContaining([expect.objectContaining({ text: 'message for second' })]))
+
+    pending.resolve({ ok: true, value: { accepted: true } })
+    await waitFor(() => { expect(firstShell.snapshot.phase).toBe('plain') })
+    fireEvent.click(view.getByRole('button', { name: 'Close first' }))
+    expect(view.queryByTestId('first')).toBeNull()
+    await act(async () => { firstViewReference.release() })
+    expect(runtime.sessions.binding(first)).toBeUndefined()
+    expect(runtime.sessions.retainInfo(first).getSnapshot().referenceCount).toBe(0)
+    expect(runtime.sessions.binding(second)).toBe(secondViewReference.binding)
+    expect(runtime.sessions.retainInfo(second).getSnapshot().referenceCount).toBe(1)
+    expect(within(secondPane).getByRole('textbox')).toBe(secondEditor)
+    act(() => { secondShell.setDraft('second still works') })
+    await waitFor(() => { expect(secondEditor.textContent).toContain('second still works') })
+    fireEvent.keyDown(secondEditor, { key: 'Enter', code: 'Enter' })
+    await waitFor(() => { expect(promptSecond).toHaveBeenCalledTimes(2) })
+    expect(promptFirst).toHaveBeenCalledOnce()
+  })
+})
