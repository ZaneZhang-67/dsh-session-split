+    expect(runtime.sessions.retainInfo(third).getSnapshot().retainedBy.conversationSplit).toBe(1)
+    expect(runtime.sessions.retainInfo(fourth).getSnapshot().retainedBy.conversationSplit).toBe(1)
+    // An intermediate Provider can commit after a newer target was published.
+    controller.commitView(view, intermediate)
+    expect(runtime.sessions.retainInfo(second).getSnapshot().retainedBy.conversationSplit).toBe(1)
+    expect(runtime.sessions.retainInfo(third).getSnapshot().retainedBy.conversationSplit).toBe(1)
+    controller.commitView(view, controller.state.getSnapshot())
