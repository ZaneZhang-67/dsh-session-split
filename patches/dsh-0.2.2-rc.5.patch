+      expect(runtime.sessions.retainInfo(second).getSnapshot().retainedBy.conversationSplit).toBe(1)
+    })
+    await waitFor(() => { expect(view.container.querySelectorAll('[data-split-pane]')).toHaveLength(0) })
+    await waitFor(() => {
+      expect(runtime.sessions.retainInfo(first).getSnapshot().retainedBy.conversationSplit).toBeUndefined()
+      expect(runtime.sessions.retainInfo(second).getSnapshot().retainedBy.conversationSplit).toBeUndefined()
+    })
+    expect(runtime.sessions.retainInfo(second).getSnapshot().retainedBy.mainView).toBe(1)
+    expect(shell.snapshot.draft).toBe('keep the second draft')
+  })
+})
