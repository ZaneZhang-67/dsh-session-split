index 00000000..bc376cee
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/split-state.ts
@@ -0,0 +1,120 @@
+/** Pure, window-local selection and geometry for up to two Session views. */
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** A position in a split Conversation. */
+export type SplitSide = 'left' | 'right'
+
+/** Empty, single, and split states never retain Session objects or references. */
+export type SplitState =
+  | { readonly kind: 'empty' }
+  | { readonly kind: 'single'; readonly sessionId: SessionId }
+  | {
+    readonly kind: 'split'
+    readonly left: SessionId
+    readonly right: SessionId
+    readonly focused: SplitSide
+    /** Fraction of the available width assigned to the left side. */
+    readonly ratio: number
+  }
+
+/** Minimum left-side width as a fraction of the available width. */
+export const MIN_SPLIT_RATIO = 0.2
+/** Maximum left-side width as a fraction of the available width. */
+export const MAX_SPLIT_RATIO = 0.8
+
+/**
+ * Create a state with no selected Session or split.
+ * @returns an empty state.
+ */
+export function createSplitState(): SplitState {
+  return { kind: 'empty' }
+}
+
+/**
+ * Select a Session in the focused side, or focus it if it is already visible.
+ * @param state - current view state.
+ * @param sessionId - selected Session id.
+ * @returns the next view state.
+ */
+export function selectSession(state: SplitState, sessionId: SessionId): SplitState {
+  if (state.kind === 'empty') return { kind: 'single', sessionId }
+  if (state.kind === 'single') {
+    return state.sessionId === sessionId ? state : { kind: 'single', sessionId }
+  }
+  if (state.left === sessionId) return focusSplit(state, 'left')
+  if (state.right === sessionId) return focusSplit(state, 'right')
+  return { ...state, [state.focused]: sessionId }
+}
+
+/**
+ * Open a Session on a side without replacing another visible Session.
+ * An empty state opens a single Session; a full split accepts only focus changes.
+ * @param state - current view state.
+ * @param sessionId - dragged Session id.
+ * @param side - intended position of the dragged Session.
+ * @returns the next view state.
+ */
+export function openSplit(state: SplitState, sessionId: SessionId, side: SplitSide): SplitState {
+  if (state.kind === 'empty') return { kind: 'single', sessionId }
+  if (state.kind === 'split') {
+    if (state.left === sessionId) return focusSplit(state, 'left')
+    if (state.right === sessionId) return focusSplit(state, 'right')
+    return state
+  }
+  if (state.sessionId === sessionId) return state
+  return {
+    kind: 'split',
+    left: side === 'left' ? sessionId : state.sessionId,
+    right: side === 'right' ? sessionId : state.sessionId,
+    focused: side,
+    ratio: 0.5,
+  }
+}
+
+/**
+ * Focus an existing split side; empty and single states are unchanged.
+ * @param state - current view state.
+ * @param side - side to focus.
+ * @returns the next view state.
+ */
+export function focusSplit(state: SplitState, side: SplitSide): SplitState {
+  if (state.kind !== 'split' || state.focused === side) return state
+  return { ...state, focused: side }
+}
+
+/**
+ * Close a split side and keep the other Session as the sole view.
+ * @param state - current view state.
+ * @param side - side to close.
+ * @returns the next view state; empty and single states are unchanged.
+ */
+export function closeSplit(state: SplitState, side: SplitSide): SplitState {
+  if (state.kind !== 'split') return state
+  return { kind: 'single', sessionId: side === 'left' ? state.right : state.left }
+}
+
+/**
+ * Remove a Session from the view when it is no longer available.
+ * @param state - current view state.
+ * @param sessionId - Session id to remove.
+ * @returns the next view state, unchanged if the Session was not visible.
+ */
+export function removeSplitSession(state: SplitState, sessionId: SessionId): SplitState {
+  if (state.kind === 'empty') return state
+  if (state.kind === 'single') return state.sessionId === sessionId ? createSplitState() : state
+  if (state.left === sessionId) return closeSplit(state, 'left')
+  if (state.right === sessionId) return closeSplit(state, 'right')
+  return state
+}
+
+/**
+ * Set the left width fraction, clamped to the split's supported range.
+ * @param state - current view state.
+ * @param ratio - requested left-side fraction; non-finite values are ignored.
+ * @returns the next view state; empty and single states are unchanged.
+ */
+export function resizeSplit(state: SplitState, ratio: number): SplitState {
+  if (state.kind !== 'split' || !Number.isFinite(ratio)) return state
+  const clamped = Math.max(MIN_SPLIT_RATIO, Math.min(MAX_SPLIT_RATIO, ratio))
+  return clamped === state.ratio ? state : { ...state, ratio: clamped }
+}
