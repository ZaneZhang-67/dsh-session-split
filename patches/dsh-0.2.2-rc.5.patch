diff --git a/packages/client/ui-conversation/src/client/split-controller.ts b/packages/client/ui-conversation/src/client/split-controller.ts
new file mode 100644
index 00000000..b1b09e81
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/split-controller.ts
@@ -0,0 +1,262 @@
+/** Window-local Conversation split selection and Session reference ownership. */
+import type { ISessions, SessionReference } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { WorkspaceSource } from '@deepseek-ai/dsh-api-workspace-controller/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { HostObservable, StandardSourceBinding } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import {
+  closeSplit, createSplitState, focusSplit, openSplit, removeSplitSession, resizeSplit, selectSession,
+  type SplitSide, type SplitState,
+} from './split-state.ts'
+
+declare module '@deepseek-ai/dsh-api-session-controller/client' {
+  interface SessionReferenceSourceMap {
+    conversationSplit: unknown
+  }
+}
+
+interface PendingSplit {
+  readonly state: SplitState
+  readonly navigate?: SessionId
+}
+
+/** Keep Session bindings alive until their rendered Provider has unmounted. */
+export class SplitController {
+  readonly state = createSnapshotStore<SplitState>(createSplitState())
+  private readonly references = new Map<SessionId, SessionReference>()
+  private readonly visible = new Map<SessionId, SessionReference>()
+  private readonly views = new Map<symbol, SplitState>()
+  private readonly stopCurrent: () => void
+  private readonly stopList: () => void
+  private readonly stopWorkspaces: () => void
+  private readonly persisted = createSnapshotStore<unknown>(null, { persist: { name: 'dsh.conversation.split' } })
+  private restorePending = true
+  private knownIds: ReadonlySet<SessionId> | undefined
+  private installing = false
+  private pending: PendingSplit | undefined
+
+  constructor(
+    private readonly sessions: ISessions,
+    private readonly current: HostObservable<StandardSourceBinding>,
+    private readonly workspaces: WorkspaceSource,
+    private readonly openSession: (id: SessionId) => void,
+  ) {
+    this.stopCurrent = current.subscribe(() => { this.followCurrent() })
+    this.stopList = sessions.list.subscribe(() => { this.reconcileList() })
+    this.stopWorkspaces = workspaces.subscribe(() => { this.restore(); this.reconcileArchives() })
+    this.reconcileList()
+    this.reconcileArchives()
+  }
+
+  private reconcileList(): void {
+    this.restore()
+    const list = this.sessions.list.getSnapshot()
+    if (list.phase !== 'ready') return
+    const previous = this.knownIds
+    this.knownIds = new Set(list.ids)
+    if (previous === undefined) return
+    const state = this.pending?.state ?? this.state.getSnapshot()
+    if (state.kind !== 'split') return
+    let next: SplitState = state
+    for (const id of [state.left, state.right]) {
+      if (previous.has(id) && !this.knownIds.has(id)) next = removeSplitSession(next, id)
+    }
+    if (next === state) return
+    const selected = next.kind === 'split' ? next[next.focused] : next.kind === 'single' ? next.sessionId : undefined
+    this.install(next, selected)
+  }
+
+  private reconcileArchives(): void {
+    const workspace = this.workspaces.getSnapshot()
+    if (workspace.phase !== 'ready') return
+    const state = this.pending?.state ?? this.state.getSnapshot()
+    if (state.kind !== 'split') return
+    let next: SplitState = state
+    for (const id of [state.left, state.right]) {
+      if (workspace.archivedSessionIds.includes(id)) next = removeSplitSession(next, id)
+    }
+    if (next === state) return
+    const selected = next.kind === 'split' ? next[next.focused] : next.kind === 'single' ? next.sessionId : undefined
+    this.install(next, selected)
+  }
+
+  private restore(): void {
+    if (!this.restorePending || this.sessions.list.getSnapshot().phase !== 'ready'
+      || this.workspaces.getSnapshot().phase !== 'ready') return
+    const current = this.current.getSnapshot().key as SessionId | undefined
+    if (current === undefined) return
+    this.restorePending = false
+    const saved = this.persisted.getSnapshot()
+    if (typeof saved !== 'object' || saved === null || !('kind' in saved) || saved.kind !== 'split'
+      || !('left' in saved) || typeof saved.left !== 'string' || saved.left === ''
+      || !('right' in saved) || typeof saved.right !== 'string' || saved.right === '' || saved.right === saved.left
+      || !('focused' in saved) || (saved.focused !== 'left' && saved.focused !== 'right')
+      || !('ratio' in saved) || typeof saved.ratio !== 'number' || !Number.isFinite(saved.ratio)) {
+      this.persisted.set(null)
+      return
+    }
+    let next: SplitState = resizeSplit({ kind: 'split', left: saved.left as SessionId, right: saved.right as SessionId,
+      focused: saved.focused, ratio: 0.5 }, saved.ratio)
+    const ids = this.sessions.list.getSnapshot().ids
+    const archived = this.workspaces.getSnapshot().archivedSessionIds
+    if (!ids.includes(saved.left as SessionId) || archived.includes(saved.left as SessionId)) next = removeSplitSession(next, saved.left as SessionId)
+    if (!ids.includes(saved.right as SessionId) || archived.includes(saved.right as SessionId)) next = removeSplitSession(next, saved.right as SessionId)
+    this.install(selectSession(next, current))
+    this.followCurrent()
+  }
+
+  private followCurrent(): void {
+    if (this.restorePending) { this.restore(); if (this.restorePending) return }
+    const state = this.pending?.state ?? this.state.getSnapshot()
+    const id = this.current.getSnapshot().key as SessionId | undefined
+    if (state.kind !== 'split' || id === undefined) return
+    const next = selectSession(state, id)
+    if (next === state) return
+    this.install(next)
+  }
+
+  private retain(id: SessionId): void {
+    if (this.references.has(id)) return
+    const reference = this.sessions.retain(id, { source: 'conversationSplit' })
+    this.references.set(id, reference)
+    void reference.ready.catch((error: unknown) => {
+      if (this.references.get(id) === reference) console.error(`[ui-conversation] failed to open split Session ${id}:`, error)
+    })
+  }
+
+  private install(next: SplitState, navigate?: SessionId): void {
+    // Retention notifies synchronously; a nested intent supersedes this one before publication.
+    this.pending = { state: next, ...(navigate === undefined ? {} : { navigate }) }
+    if (this.installing) return
+    this.installing = true
+    let completed = false
+    try {
+      while (this.pending !== undefined) {
+        const candidate: PendingSplit = this.pending
+        const state = candidate.state
+        if (state.kind === 'split') {
+          this.retain(state.left)
+          if (this.pending !== candidate) continue
+          this.retain(state.right)
+          if (this.pending !== candidate) continue
+        }
+        if (candidate.navigate !== undefined && candidate.navigate !== this.current.getSnapshot().key) {
+          this.openSession(candidate.navigate)
+          if (this.pending !== candidate) continue
+        }
+        this.state.set(state)
+        if (this.pending !== candidate) continue
+        this.persisted.set(state.kind === 'split' ? state : null)
+        if (this.pending !== candidate) continue
+        this.pending = undefined
+        this.committed()
+      }
+      completed = true
+    } finally {
+      this.installing = false
+      if (!completed) {
+        this.pending = undefined
+        this.committed()
+      }
+    }
+  }
+
+  /** @returns the retained reference for a currently rendered split Session. */
+  reference(id: SessionId): SessionReference {
+    const reference = this.references.get(id)
+    if (reference === undefined) throw new Error(`ui-conversation: split Session ${id} has no reference`)
+    return reference
+  }
+
+  /** Open a dragged Session at the chosen edge. */
+  drop(id: SessionId, side: SplitSide): void {
+    this.restorePending = false
+    const current = this.current.getSnapshot().key as SessionId | undefined
+    const state = this.pending?.state ?? this.state.getSnapshot()
+    const base = state.kind === 'split' ? state : current === undefined ? createSplitState() : selectSession(createSplitState(), current)
+    const next = openSplit(base, id, side)
+    if (next === base && state.kind === 'split') return
+    const selected = next.kind === 'split' ? next[next.focused] : next.kind === 'single' ? next.sessionId : undefined
+    this.install(next, selected)
+  }
+
+  /** Select a visible side and synchronize global navigation. */
+  focus(side: SplitSide): void {
+    const current = this.pending?.state ?? this.state.getSnapshot()
+    const next = focusSplit(current, side)
+    if (next === current || next.kind !== 'split') return
+    this.install(next, next[side])
+  }
+
+  /** Remove one pane without removing or stopping its Session. */
+  close(side: SplitSide): void {
+    const state = this.pending?.state ?? this.state.getSnapshot()
+    const next = closeSplit(state, side)
+    if (next === state) return
+    this.install(next, next.kind === 'single' ? next.sessionId : undefined)
+  }
+
+  /** Set the left-pane fraction. */
+  resize(ratio: number): void {
+    const state = this.pending?.state ?? this.state.getSnapshot()
+    const next = resizeSplit(state, ratio)
+    if (next !== state) this.install(next, this.pending?.navigate)
+  }
+
+  /** Retain only the panes currently visible in the mounted layout. */
+  setVisible(ids: readonly SessionId[]): void {
+    for (const id of ids) {
+      if (this.visible.has(id)) continue
+      const reference = this.sessions.retain(id, { source: 'visibleConversation' })
+      this.visible.set(id, reference)
+      void reference.ready.catch((error: unknown) => {
+        if (this.visible.get(id) === reference) console.error(`[ui-conversation] failed to open visible Session ${id}:`, error)
+      })
+    }
+    for (const [id, reference] of this.visible) {
+      if (ids.includes(id)) continue
+      this.visible.delete(id)
+      reference.release()
+    }
+  }
+
+  /** Register an individual committed Conversation panel. */
+  mountView(view: symbol, state: SplitState): void {
+    this.views.set(view, state)
+  }
+
+  /** Advance a panel's retained layout after React commits it. */
+  commitView(view: symbol, state: SplitState): void {
+    if (!this.views.has(view)) throw new Error('ui-conversation: split panel committed without mounting')
+    this.views.set(view, state)
+    this.committed()
+  }
+
+  /** Remove an unmounted panel and release its retired references. */
+  unmountView(view: symbol): void {
+    this.views.delete(view)
+    this.committed()
+  }
+
+  /** Release retired references after every mounted panel commits the current layout. */
+  committed(): void {
+    const state = this.state.getSnapshot()
+    if (this.pending !== undefined || [...this.views.values()].some(committed => committed !== state)) return
+    for (const [id, reference] of this.references) {
+      if (state.kind === 'split' && (state.left === id || state.right === id)) continue
+      this.references.delete(id)
+      reference.release()
+    }
+  }
+
+  /** Release the navigation subscription and every remaining reference. */
+  dispose(): void {
+    this.stopCurrent()
+    this.stopList()
+    this.stopWorkspaces()
+    this.setVisible([])
+    this.views.clear()
+    for (const reference of this.references.values()) reference.release()
+    this.references.clear()
+  }
+}
