+    const view = Symbol('panel')
+    onTestFinished(async () => { controller.unmountView(view); controller.dispose(); main?.release(); await runtime.dispose(); localStorage.clear() })
+    controller.mountView(view, { kind: 'single', sessionId: first })
+    controller.drop(second, 'right')
+    controller.commitView(view, controller.state.getSnapshot())
