+.frame {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  container-type: inline-size;
+}
+
+.columns {
+  display: grid;
+  grid-template-columns: minmax(350px, min(var(--split-ratio), calc(100% - 350px))) 0 minmax(350px, 1fr);
+  /* Long conversations scroll inside each pane, never expand the shared row. */
+  grid-template-rows: minmax(0, 1fr);
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+}
+
+.pane {
+  position: relative;
+  min-width: 0;
+  min-height: 0;
+  height: 100%;
+}
+
+.pane[data-split-pane='left'] {
+  grid-column: 1;
+  grid-row: 1;
+}
+
+.pane[data-split-pane='right'] {
+  grid-column: 3;
+  grid-row: 1;
+}
+
+.pane[data-focused]::after {
+  position: absolute;
+  z-index: 2;
+  inset: 0;
+  border: 0.5px solid var(--dsw-alias-border-l3);
+  content: '';
+  pointer-events: none;
+}
+
+.close {
+  position: absolute;
+  z-index: 3;
+  top: 9px;
+  right: 4px;
+  display: grid;
+  place-items: center;
+  width: 26px;
+  height: 26px;
+  padding: 0;
+  border: 0;
+  border-radius: var(--dsw-radius-md);
+  background: var(--dsw-alias-bg-base);
+  color: var(--dsw-alias-label-tertiary);
+  cursor: pointer;
+}
+
+@media (hover: hover) {
+  .close:hover { color: var(--dsw-alias-label-primary); }
+}
+
+.divider {
+  grid-column: 2;
+  grid-row: 1;
+  position: relative;
+  z-index: 4;
+  width: 8px;
+  height: 100%;
+  margin-left: -4px;
+  cursor: col-resize;
+  touch-action: none;
+  background: var(--dsw-alias-border-l3);
+}
+
+.preview {
+  position: absolute;
+  z-index: 5;
+  inset-block: 0;
+  width: 25%;
+  background: var(--dsw-alias-border-l3);
+  opacity: 0.4;
+  pointer-events: none;
+}
+
+.preview[data-side='left'] { left: 0; }
+.preview[data-side='right'] { right: 0; }
+
+@container (width >= 700px) {
+  :global([data-platform='darwin']) .pane[data-split-pane='right'] {
+    --dsh-frame-leading-clearance: 0px;
