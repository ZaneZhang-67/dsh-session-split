+class MeasuredResizeObserver {
+  static callbacks = new Set<ResizeObserverCallback>()
+  constructor(private readonly callback: ResizeObserverCallback) { MeasuredResizeObserver.callbacks.add(callback) }
+  observe(): void {}
+  unobserve(): void {}
+  disconnect(): void { MeasuredResizeObserver.callbacks.delete(this.callback) }
+  static changed(): void { for (const cb of MeasuredResizeObserver.callbacks) cb([], {} as ResizeObserver) }
+}
