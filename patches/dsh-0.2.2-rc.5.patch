+++ b/packages/client/ui-conversation/tests/split-module-lifecycle.client.spec.tsx
@@ -0,0 +1,134 @@
+// @vitest-environment jsdom
+/** Regression evidence for replacing the Session adapter while the real renderer stays mounted. */
+import { execFileSync } from 'node:child_process'
+import * as Cordis from '@deepseek-ai/cordis'
+import Loader from '@deepseek-ai/cordis-plugin-loader'
+import * as React from 'react'
+import * as ReactDOM from 'react-dom'
+import * as ReactDOMClient from 'react-dom/client'
+import * as JsxRuntime from 'react/jsx-runtime'
+import { act } from '@testing-library/react'
+import { describe, expect, it, onTestFinished, vi } from 'vitest'
+import * as Store from '@deepseek-ai/dsh-client-store'
+import * as Slots from '@deepseek-ai/dsh-client-ui-slots'
+import { StaticRemoteAccess, TestRemote, TestSessions } from '@deepseek-ai/dsh-client-test-runtime'
+import * as UiSession from '../../ui-session/src/client/index.ts'
+import * as UiRenderer from '../../ui-renderer/src/client/index.ts'
+import { createClientModuleSystem } from '../../modules/src/client/index.ts'
+import type { ClientModuleLoaderTarget, WebBootEntry, WebBootGraph } from '../../modules/src/client/index.ts'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { SessionReference } from '@deepseek-ai/dsh-api-session-controller/client'
+
+const sessionId = '@deepseek-ai/dsh-client-ui-session'
+const rendererId = '@deepseek-ai/dsh-client-ui-renderer'
+type ModuleId = typeof sessionId | typeof rendererId
+const session = 'lifecycle-session' as SessionId
+
+/** The optional installed-artifact lane uses only the named installation, never profile or browser state. */
+function artifact(id: ModuleId): string {
+  const installation = process.env.DSH_HMR_REPRO_INSTALL_DIR
+  const executable = process.env.DSH_NODE_EXECUTABLE
+  if (installation === undefined || executable === undefined) {
+    throw new Error('installed-artifact lane requires DSH_HMR_REPRO_INSTALL_DIR and DSH_NODE_EXECUTABLE')
+  }
+  return execFileSync(executable, ['-e',
+    'const fs=require("node:fs"),path=require("node:path"); const pkg=require.resolve(process.argv[1]+"/package.json", {paths:[process.argv[2]]}); process.stdout.write(fs.readFileSync(path.join(path.dirname(pkg),"lib/client.js"),"utf8"))',
+    id, installation,
+  ], { encoding: 'utf8', env: { ...process.env, ELECTRON_RUN_AS_NODE: '1' }, maxBuffer: 4 * 1024 * 1024, timeout: 5000 })
+}
+
+const row = (id: ModuleId): WebBootEntry => ({ id, rev: 'initial', url: `/plugins/??${id}/client.js&rev=initial` })
+const initial: WebBootGraph = {
+  rev: 'initial', entries: [row(rendererId), row(sessionId)],
+  batches: [{ phase: 'application', url: '/fixture/batch', rev: 'initial', entries: [rendererId, sessionId] }],
+}
+
+async function fixture(mode: 'source' | 'artifact') {
+  expect(process.hasUncaughtExceptionCaptureCallback()).toBe(false)
+  const ctx = new Cordis.Context()
+  const container = document.createElement('div')
+  let unmount: (() => void) | undefined
+  let reference: SessionReference | undefined
+  const errors: string[] = []
+  const uncaught: Error[] = []
+  const consoleError = vi.spyOn(console, 'error').mockImplementation((...args: unknown[]) => {
+    errors.push(args.map(value => value instanceof Error ? value.message : String(value)).join(' '))
+  })
+  const onError = (event: ErrorEvent) => { errors.push(event.message); event.preventDefault() }
+  // Register teardown before artifact loading or asynchronous plugin setup can fail.
+  onTestFinished(async () => {
+    try {
+      await act(async () => { unmount?.(); await ctx.fiber.dispose(); await ctx.fiber.await() })
+      reference?.release()
+    } finally {
+      container.remove()
+      window.removeEventListener('error', onError)
+      consoleError.mockRestore()
+      process.setUncaughtExceptionCaptureCallback(null)
+    }
+  })
+  // React rethrows a failed root from a microtask. Capture that expected failure without
+  // adding an ErrorBoundary (which would change the production tree under examination).
+  process.setUncaughtExceptionCaptureCallback(error => { uncaught.push(error) })
+  window.addEventListener('error', onError)
+  const sessions = new TestSessions(async fn => { await fn() }, ctx)
+  ctx.provide('sessions', sessions)
+  new TestRemote(ctx)
+  new StaticRemoteAccess(ctx)
+  const staticModules = {
+    '@deepseek-ai/cordis': Cordis,
+    '@deepseek-ai/dsh-client-store': Store,
+    '@deepseek-ai/dsh-client-ui-slots': Slots,
+    'react': React,
+    'react-dom': ReactDOM,
+    'react-dom/client': ReactDOMClient,
+    'react/jsx-runtime': JsxRuntime,
+  }
+  const source = { [sessionId]: UiSession, [rendererId]: UiRenderer }
+  const artifacts = mode === 'artifact' ? { [sessionId]: artifact(sessionId), [rendererId]: artifact(rendererId) } : undefined
+  const target: ClientModuleLoaderTarget = {
+    mode: 'queue', pendingQueue: [], load: () => {},
+    create: options => createClientModuleSystem(target, { id: 'fixture-bootstrap', exports: {} }, options),
+  }
+  const modules = target.create({
+    boot: initial, staticModules,
+    loadBundle: async url => {
+      const ids: readonly ModuleId[] = url === '/fixture/batch' ? [rendererId, sessionId] : [url.includes(sessionId) ? sessionId : rendererId]
+      for (const id of ids) {
+        if (artifacts === undefined) target.load({ id, factory: () => source[id] })
+        else new Function('window', artifacts[id])({ __ModuleLoader__: target })
+      }
+    },
+  })
+  await ctx.plugin(Loader)
+  ctx.loader.internal = modules as never
+  await modules.entries.start(ctx.loader, modules.manifest)
+  await sessions.add({ id: session, summary: { title: 'Lifecycle session', displayTitle: 'Lifecycle session' } })
+  reference = sessions.retain(session, { source: 'mainView' })
+  await reference.ready
+  ctx.slots.register({ name: 'root' }, () => <main data-testid="real-root">Session surface</main>)
+  document.body.append(container)
+  await act(async () => { unmount = ctx.uiRenderer.mount(container) })
+  return { ctx, modules, container, errors, uncaught }
+}
+
+describe('Session adapter module replacement', () => {
+  for (const mode of ['source', 'artifact'] as const) {
+    // Ordinary source tests do not require a local Desktop installation or generated build artifacts.
+    it.skipIf(mode === 'artifact' && process.env.DSH_HMR_REPRO_INSTALL_DIR === undefined)(`unmounts the real root during asynchronous ui-session replacement (${mode})`, async () => {
+      const f = await fixture(mode)
+      expect(f.container.querySelector('[data-testid="real-root"]')?.textContent).toBe('Session surface')
+      let reactError: unknown
+      try {
+        // As in the SSE callback, do not batch asynchronous teardown/reload into one React act.
+        await f.modules.entries.reload(sessionId, 'replacement')
+        await act(async () => {})
+      } catch (error) { reactError = error }
+      expect([String(reactError), ...f.errors].join('\n')).toContain("scope 'session-maybe' rendered without an installed adapter")
+      expect(f.uncaught.map(error => error.message)).toEqual(["scope 'session-maybe' rendered without an installed adapter"])
+      expect(f.ctx.get('uiSession')).toBeDefined()
+      expect(f.modules.entries.state.getSnapshot()).toEqual({ syncing: false, failures: [] })
+      expect(f.container.childElementCount).toBe(0)
+    })
+  }
+})
