{
  "name": "@local/dsh-session-split",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Two independently editable Session panes for DeepSeek Harness Desktop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZaneZhang-67/dsh-session-split.git"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "=0.2.2-rc.5"
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml", "modules", "locale", "icon.svg", "README.md",
    "LICENSE", "THIRD_PARTY_NOTICES.md", "UPSTREAM.json", "checksums.json",
    "scripts", "patches", "docs"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "export": "node scripts/export.mjs",
    "pack:release": "node scripts/pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
